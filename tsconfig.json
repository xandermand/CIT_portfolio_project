{
    "compilerOptions": {
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "sourceMap": true,
        "types": ["node"],
        "esModuleInterop": true
    },
    "include": ["src/**/*"],
    "exclude": ["dist"]
}